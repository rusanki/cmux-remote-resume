#!/usr/bin/env bash
# The command cmux runs in a restored pane. Reads this pane's saved mapping
# (agent, session UUID, cwd, VM) and reopens exactly that; never guesses a
# session by directory or recency.
#
# The VM may still be booting, or left Broken by a host reboot, when cmux
# restores many panes at once. This waits for cmux-vm-ready.py, retries a
# connection that fails before the guest shell ran, and offers a one-key retry
# instead of silently dropping to a host shell.
set -eu
CMUX_LIMA_ROOT=$(cd "$(dirname "$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")/.." && pwd -P)
. "$CMUX_LIMA_ROOT/lib/cmux-lima-env.sh"
values=$(python3 "$CMUX_LIMA_ROOT/lib/cmux-vm-state.py" read-env) || exit 1
eval "$values"
VM_NAME="${GVM:-$CMUX_VM_NAME}"
extra_env=()
if [ -n "${GCODEX_HOME:-}" ]; then extra_env+=("CODEX_HOME=$GCODEX_HOME"); fi
MAX_ATTEMPTS="${CMUX_VM_RESTORE_ATTEMPTS:-3}"

connect() {
    limactl shell "$VM_NAME" -- env \
        CMUX_SURFACE_ID="${CMUX_SURFACE_ID:-${CMUX_PANEL_ID:-}}" \
        CMUX_VM_NAME="$VM_NAME" CMUX_VM_CD="${GCWD:-}" \
        CMUX_VM_AGENT="$GAGENT" CMUX_RESUME_SID="$GSESSION" \
        CMUX_VM_AGENT_MODE="$CMUX_VM_AGENT_MODE" CMUX_VM_GUEST_ROOT="$CMUX_VM_GUEST_ROOT" \
        ${extra_env[@]+"${extra_env[@]}"} \
        bash -ic "source '$CMUX_VM_GUEST_ROOT/lib/cmux-vm-run.sh'"
}

while :; do
    attempt=0
    while [ "$attempt" -lt "$MAX_ATTEMPTS" ]; do
        attempt=$((attempt+1))
        if python3 "$CMUX_LIMA_ROOT/lib/cmux-vm-ready.py" "$VM_NAME"; then
            started=$(date +%s)
            rc=0
            connect || rc=$?
            # ssh itself exits 255; anything else is the guest shell's own status.
            if [ "$rc" -ne 255 ]; then exit "$rc"; fi
            if [ $(( $(date +%s) - started )) -gt 30 ]; then
                echo "vm-restore: connection to VM '$VM_NAME' dropped." >&2
                exit "$rc"
            fi
            echo "vm-restore: could not connect to VM '$VM_NAME' (attempt $attempt of $MAX_ATTEMPTS)." >&2
        fi
        [ "$attempt" -lt "$MAX_ATTEMPTS" ] && sleep $((attempt*2))
    done
    echo "vm-restore: VM '$VM_NAME' is not reachable. The saved session is retained." >&2
    if [ -t 0 ]; then
        printf 'Press Enter to retry, or Ctrl-C for a host shell. '
        read -r _ || exit 1
    else
        exit 1
    fi
done
