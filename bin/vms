#!/usr/bin/env bash
# vms [remote-dir] [--target NAME]: plain shell on the remote with cmux pane
# restore. The shell records its cwd on every prompt, so after a cmux restart
# or a reboot the pane reopens a shell in the directory you were last in.
# Starting claude or codex inside it upgrades the pane to a resumable session.
set -u
CMUX_REMOTE_HOME=$(cd "$(dirname "$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")/.." && pwd -P)
. "$CMUX_REMOTE_HOME/lib/cmux-remote-env.sh"
. "$CMUX_REMOTE_HOME/lib/cmux-remote-transport.sh"
TARGET="$CMUX_TARGET_DEFAULT"
DIR=""
while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target) TARGET="${2:?vms: --target needs a name}"; shift 2 ;;
        --target=*) TARGET="${1#*=}"; shift ;;
        -h|--help) echo 'usage: vms [remote-dir] [--target NAME]'; exit 0 ;;
        -*) echo "vms: unknown option: $1" >&2; exit 2 ;;
        *) DIR="$1"; shift ;;
    esac
done
SID="${CMUX_SURFACE_ID:-${CMUX_PANEL_ID:-}}"
cmux_target_resolve "$TARGET" || exit 2
cmux_remote_ready "$TARGET" || exit 1

if [ -n "$DIR" ]; then
    case "$DIR" in
        /*|'~'/*) : ;;
        *)  echo "vms: dir must be an absolute remote path, got: '$DIR'" >&2; exit 2 ;;
    esac
    if ! cmux_remote_exec "$TARGET" "test -d $DIR" 2>/dev/null; then
        echo "vms: remote directory does not exist: $DIR" >&2
        exit 2
    fi
    mkdir -p "$CMUX_REMOTE_CACHE" 2>/dev/null
    printf '%s\n' "${DIR%/}" >> "$CMUX_REMOTE_CACHE/history-$TARGET" 2>/dev/null || true
fi

if [ -n "$SID" ]; then
    mkdir -p "$CMUX_REMOTE_CACHE/panes"
    printf '%s\n' "$TARGET" > "$CMUX_REMOTE_CACHE/panes/$SID"
    # --source vmc routes through cmux's approval flow; the auto record minted
    # at first approval covers every pane that uses remote-restore.
    "$CMUX_CLI" surface resume set --kind vm --name "$TARGET shell" --cwd "$HOME" \
        --source vmc --shell "$CMUX_REMOTE_HOME/bin/remote-restore" >/dev/null 2>&1 || true
else
    echo "vms: no CMUX_SURFACE_ID; the shell will run but will not auto-restore." >&2
fi

cmux_remote_shell "$TARGET" "source $T_ROOT/lib/cmux-remote-run.sh" \
    "CMUX_SURFACE_ID=$SID" "CMUX_TARGET=$TARGET" "CMUX_REMOTE_CD=$DIR" \
    "CMUX_REMOTE_AGENT=" "CMUX_RESUME_SID=" "CMUX_AGENT_MODE=$CMUX_AGENT_MODE"
