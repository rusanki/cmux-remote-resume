#!/usr/bin/env bash
# vmpaste: bridge a macOS clipboard image to the remote so an agent running
# there can read it. Copies the image to ~/.cache/cmux-remote/clip on the
# remote and yields that path.
#
#   vmpaste [--target NAME]    copy; if run from a cmux pane, type the remote
#                              path into the focused terminal, else copy it
#   vmpaste --surface <ref>    copy and type the path into a specific surface
#   vmpaste --clip             copy and put the remote path on the clipboard only
set -u
CMUX_REMOTE_HOME=$(cd "$(dirname "$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")/.." && pwd -P)
. "$CMUX_REMOTE_HOME/lib/cmux-remote-env.sh"
. "$CMUX_REMOTE_HOME/lib/cmux-remote-transport.sh"
TARGET="$CMUX_TARGET_DEFAULT"
TARGET_SURFACE="" ; TARGET_WS="" ; FORCE_CLIP=""
while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target) TARGET="${2:?}"; shift 2 ;;
        --target=*) TARGET="${1#*=}"; shift ;;
        --surface) TARGET_SURFACE="${2:-}" ; TARGET_WS="${CMUX_WORKSPACE_ID:-}"; shift 2 ;;
        --surface=*) TARGET_SURFACE="${1#*=}" ; TARGET_WS="${CMUX_WORKSPACE_ID:-}"; shift ;;
        --clip|--clipboard) FORCE_CLIP=1; shift ;;
        *) echo "vmpaste: unknown option $1" >&2; exit 2 ;;
    esac
done
CLI="$CMUX_CLI"
if [ -z "$FORCE_CLIP" ] && [ -z "$TARGET_SURFACE" ]; then
    read -r TARGET_SURFACE TARGET_WS < <(
        "$CLI" identify --no-caller --id-format both 2>/dev/null | python3 -c '
import json,sys
try:
    f=json.load(sys.stdin).get("focused",{})
    if f.get("surface_type")=="terminal" and not f.get("is_browser_surface"):
        print(f.get("surface_id") or "", f.get("workspace_id") or "")
except Exception:
    pass
' 2>/dev/null)
fi
[ -n "$FORCE_CLIP" ] && TARGET_SURFACE=""

mkdir -p "$CMUX_REMOTE_CACHE/clip" 2>/dev/null
ts=$(date +%Y%m%d-%H%M%S)
host_out="$CMUX_REMOTE_CACHE/clip/paste-$ts.png"
res=$(osascript <<APPLESCRIPT 2>/dev/null
try
    set outFile to POSIX file "$host_out"
    set imgData to (the clipboard as «class PNGf»)
    set fh to open for access outFile with write permission
    set eof fh to 0
    write imgData to fh
    close access fh
    return "ok"
on error errMsg
    try
        close access (POSIX file "$host_out")
    end try
    return "err:" & errMsg
end try
APPLESCRIPT
)
if [ "$res" != "ok" ] || [ ! -s "$host_out" ]; then
    rm -f "$host_out" 2>/dev/null
    echo "vmpaste: no image on the clipboard (copy a screenshot first)." >&2
    exit 1
fi

remote_home=$(cmux_remote_home "$TARGET") || { echo "vmpaste: cannot reach '$TARGET'" >&2; exit 1; }
remote_dir="$remote_home/.cache/cmux-remote/clip"
cmux_remote_exec "$TARGET" "mkdir -p $(printf '%q' "$remote_dir")" || exit 1
remote_path="$remote_dir/paste-$ts.png"
cmux_remote_copy "$TARGET" "$host_out" "$remote_path" || { echo "vmpaste: copy to '$TARGET' failed" >&2; exit 1; }

if [ -n "$TARGET_SURFACE" ]; then
    ws_args=()
    [ -n "$TARGET_WS" ] && ws_args=(--workspace "$TARGET_WS")
    if "$CLI" send ${ws_args[@]+"${ws_args[@]}"} --surface "$TARGET_SURFACE" "$remote_path " >/dev/null 2>&1; then
        echo "vmpaste: image -> $TARGET:$remote_path  (typed into the focused pane)"
        exit 0
    fi
    echo "vmpaste: could not type into the focused pane; falling back to clipboard." >&2
fi
printf '%s' "$remote_path" | pbcopy
echo "vmpaste: image -> $TARGET:$remote_path  (remote path copied to clipboard)"
