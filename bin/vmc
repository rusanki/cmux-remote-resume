#!/usr/bin/env bash
# vmc [remote-dir] [--claude|--codex] [--resume <uuid>] [--target NAME]
# Launch Claude Code or Codex on a remote (Lima VM or ssh host) from a cmux
# pane. The pane's restore binding is registered so cmux reopens the exact
# session later.
set -eu
CMUX_REMOTE_HOME=$(cd "$(dirname "$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")")/.." && pwd -P)
. "$CMUX_REMOTE_HOME/lib/cmux-remote-env.sh"
. "$CMUX_REMOTE_HOME/lib/cmux-remote-transport.sh"
TARGET="$CMUX_TARGET_DEFAULT"
SID="${CMUX_SURFACE_ID:-${CMUX_PANEL_ID:-}}"
DIR="" RSID="" AGENT=""
while [ $# -gt 0 ]; do
    case "$1" in
        --claude) AGENT=claude; shift ;;
        --codex) AGENT=codex; shift ;;
        --agent) AGENT="${2:?vmc: --agent needs claude or codex}"; shift 2 ;;
        -t|--target) TARGET="${2:?vmc: --target needs a name}"; shift 2 ;;
        --target=*) TARGET="${1#*=}"; shift ;;
        -r|--resume) RSID="${2:?vmc: --resume needs a session UUID}"; shift 2 ;;
        --resume=*) RSID="${1#*=}"; shift ;;
        -h|--help)
            echo 'usage: vmc [remote-dir] [--claude|--codex|--agent claude|codex] [--resume <session-UUID>] [--target NAME]'
            echo 'Without an agent flag, vmc offers a Claude / Codex menu.'
            exit 0 ;;
        -*) echo "vmc: unknown option: $1" >&2; exit 2 ;;
        *) if [ -z "$DIR" ]; then DIR="$1"; shift; else echo 'vmc: too many directories' >&2; exit 2; fi ;;
    esac
done
if [ -z "$AGENT" ]; then
    if [ ! -t 0 ]; then
        echo 'vmc: select an agent with --claude or --codex when running non-interactively.' >&2
        exit 2
    fi
    printf '\nChoose an agent:\n  1) Claude\n  2) Codex\n'
    while :; do
        read -r -p 'Agent [1/2, default 1]: ' choice || exit 1
        case "$choice" in
            ''|1|claude|Claude) AGENT=claude; break ;;
            2|codex|Codex) AGENT=codex; break ;;
            *) echo 'Enter 1 for Claude or 2 for Codex.' ;;
        esac
    done
fi
case "$AGENT" in claude|codex) ;; *) echo "vmc: unsupported agent: $AGENT" >&2; exit 2 ;; esac
cmux_target_resolve "$TARGET"
cmux_remote_ready "$TARGET"
if [ -n "$RSID" ]; then
    RESOLVED=$(cmux_remote_exec "$TARGET" "python3 $T_ROOT/lib/cmux-remote-resolve.py $(printf '%q' "$AGENT") $(printf '%q' "$RSID")") || exit 2
    DIR="${DIR:-$RESOLVED}"
fi
if [ -n "$DIR" ]; then
    case "$DIR" in /*|'~'/*) ;; *) echo 'vmc: directory must be an absolute remote path.' >&2; exit 2 ;; esac
    cmux_remote_exec "$TARGET" "test -d $DIR" || { echo "vmc: remote directory does not exist: $DIR" >&2; exit 2; }
    mkdir -p "$CMUX_REMOTE_CACHE"
    printf '%s\n' "${DIR%/}" >> "$CMUX_REMOTE_CACHE/history-$TARGET"
fi
if [ -n "$SID" ]; then
    mkdir -p "$CMUX_REMOTE_CACHE/panes"
    printf '%s\n' "$TARGET" > "$CMUX_REMOTE_CACHE/panes/$SID"
    "$CMUX_CLI" surface resume set --kind vm --name "$TARGET $AGENT" --cwd "$HOME" \
        --source vmc --shell "$CMUX_REMOTE_HOME/bin/remote-restore" >/dev/null || {
        echo 'vmc: could not register pane restore; refusing to launch an untracked session.' >&2; exit 1;
    }
else
    echo 'vmc: outside a cmux pane; automatic restore is unavailable.' >&2
fi
cmux_remote_shell "$TARGET" "source $T_ROOT/lib/cmux-remote-run.sh" \
    "CMUX_SURFACE_ID=$SID" "CMUX_TARGET=$TARGET" "CMUX_REMOTE_CD=$DIR" \
    "CMUX_REMOTE_AGENT=$AGENT" "CMUX_RESUME_SID=$RSID" "CMUX_AGENT_MODE=$CMUX_AGENT_MODE"
