# cmux-lima-resume configuration. Copy to ~/.config/cmux-lima/config.
# Plain KEY=VALUE lines. Environment variables with the same name take
# precedence over this file.

# Lima instance the launchers talk to.
CMUX_VM_NAME=ubuntu

# Where this repository is visible INSIDE the guest. The directory must be
# mounted writable, because the guest hooks write session mappings to state/.
# With Lima's default home mount this is the same path as on the host.
CMUX_VM_GUEST_ROOT=/Users/you/projects/cmux-lima-resume

# Agent permission mode inside the VM:
#   default  - agents run with their normal permission prompts
#   bypass   - claude --dangerously-skip-permissions, codex --dangerously-bypass-approvals-and-sandbox
# The VM is the sandbox; "bypass" is what the author runs. Choose deliberately.
CMUX_VM_AGENT_MODE=default

# cmux's bundled CLI (used to register the pane's restore command).
# CMUX_CLI=/Applications/cmux.app/Contents/Resources/bin/cmux
