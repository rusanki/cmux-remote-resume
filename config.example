# cmux-remote-resume configuration. Copy to ~/.config/cmux-remote/config.
# Plain KEY=VALUE lines. Environment variables with the same name take
# precedence over this file.

# Targets: CMUX_TARGET_<name>=<backend>:<address>[:<remote-root>]
#   lima  address = Lima instance name. Remote root defaults to this checkout's
#         own path, which Lima's default home mount exposes read-only (enough:
#         state is written to the remote's ~/.cache, not into the repo).
#   ssh   address = ssh destination or ~/.ssh/config alias. Remote root
#         defaults to ~/.cmux-remote-resume; install.sh syncs the repo there.
# A target name with no line here means lima:<name>. The Lima instance must
# already exist: an unknown name is an error, never a freshly created VM.
CMUX_TARGET_ubuntu=lima:ubuntu
#CMUX_TARGET_devbox=ssh:devbox
#CMUX_TARGET_build=ssh:me@build.example.com:/opt/cmux-remote-resume

# Which target vmc / vms / vmpaste use without --target.
CMUX_TARGET_DEFAULT=ubuntu

# Extra ssh/scp options for the ssh backend, e.g. a config file.
#CMUX_SSH_OPTS=-F /Users/you/.ssh/work_config

# Agent permission mode on the remote:
#   default  - agents run with their normal permission prompts
#   bypass   - claude --dangerously-skip-permissions, codex --dangerously-bypass-approvals-and-sandbox
# The remote is the sandbox; "bypass" is what the author runs. Choose deliberately.
CMUX_AGENT_MODE=default

# cmux's bundled CLI (used to register the pane's restore command).
#CMUX_CLI=/Applications/cmux.app/Contents/Resources/bin/cmux
